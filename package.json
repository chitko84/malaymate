{
  "name": "malaymate-react-adventure",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "test": "node scripts/check.mjs && node --import tsx scripts/adventure-tests.ts && node --import tsx scripts/story-tests.ts && node --import tsx scripts/arcade-tests.ts",
    "db:generate": "drizzle-kit generate",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.1.0",
    "typescript": "^5.8.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.25.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0"
  }
}
